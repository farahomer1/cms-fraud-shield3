# Copy this file to enrollment_agent/.env and fill in your values.
# ADK auto-loads enrollment_agent/.env at run and deploy time.

# --- Option A: Argolis / Vertex AI (recommended for this demo) ---------------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-argolis-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Option B: Google AI Studio API key (instead of Vertex) ------------------
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-api-key
